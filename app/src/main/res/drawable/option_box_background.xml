<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#eff6ff" />
            <stroke android:width="3dp" android:color="@color/blue_primary" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape>
            <solid android:color="@color/white" />
            <stroke android:width="3dp" android:color="@color/gray_200" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>