<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_alt">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:elevation="@dimen/elevation_sm"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background"
            android:text="←"
            android:textSize="@dimen/text_xxl" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/result_title"
            android:textSize="@dimen/text_lg"
            android:textColor="@color/gray_800"
            android:textStyle="bold"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background"
            android:text="🔄"
            android:textSize="@dimen/text_lg" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <!-- Map Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_lg">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_hero">

                    <!-- Aquí irá el MapView real -->
                    <fragment
                        android:id="@+id/mapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Placeholder mientras tanto -->
                    <LinearLayout
                        android:id="@+id/mapPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/gradient_hero">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️"
                            android:textSize="40sp"
                            android:layout_marginBottom="@dimen/spacing_md" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/map_placeholder"
                            android:textSize="@dimen/text_lg"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/map_subtitle"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/white"
                            android:alpha="0.9"
                            android:layout_marginTop="@dimen/spacing_xs" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Legend Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_md"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/legend_title"
                        android:textSize="@dimen/text_lg"
                        android:textColor="@color/gray_800"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginBottom="@dimen/spacing_lg" />

                    <!-- Red Zone -->
                    <include layout="@layout/item_legend_row"
                        android:id="@+id/legendRed" />

                    <!-- Orange Zone -->
                    <include layout="@layout/item_legend_row"
                        android:id="@+id/legendOrange" />

                    <!-- Yellow Zone -->
                    <include layout="@layout/item_legend_row"
                        android:id="@+id/legendYellow" />

                    <!-- Green Zone -->
                    <include layout="@layout/item_legend_row"
                        android:id="@+id/legendGreen" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginTop="@dimen/spacing_xl">

                <!-- Add Finding Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFinding"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/action_add_finding"
                    android:textSize="@dimen/text_sm"
                    android:backgroundTint="@color/blue_primary"
                    app:icon="@drawable/baseline_add_24"
                    app:iconSize="@dimen/icon_md"
                    app:cornerRadius="@dimen/radius_lg" />

                <!-- Save Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/action_save"
                    android:textSize="@dimen/text_sm"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/gray_800"
                    app:icon="@drawable/baseline_save_24"
                    app:iconSize="@dimen/icon_md"
                    app:cornerRadius="@dimen/radius_lg"
                    app:iconTint="@color/black"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gray_200" />

                <!-- Share Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/action_share"
                    android:textSize="@dimen/text_sm"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/gray_800"
                    app:icon="@drawable/baseline_share_24"
                    app:iconTint="@color/black"
                    app:iconSize="@dimen/icon_md"
                    app:cornerRadius="@dimen/radius_lg"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gray_200" />

                <!-- Download Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="@string/action_download"
                    android:textSize="@dimen/text_sm"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/gray_800"
                    app:icon="@drawable/baseline_download_24"
                    app:iconSize="@dimen/icon_md"
                    app:cornerRadius="@dimen/radius_lg"
                    app:iconTint="@color/black"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gray_200" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>